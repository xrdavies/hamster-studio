{
  "name": "hamster-studio",
  "version": "0.0.1",
  "description": "A local desktop chat and image client for custom OpenAI Compatible providers",
  "scripts": {
    "dev": "tauri dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build": "tauri build",
    "build:dir": "tauri build --no-bundle",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs",
    "dev:renderer": "vite",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrdavies/hamster-studio.git"
  },
  "keywords": [],
  "author": "Frozen",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/xrdavies/hamster-studio/issues"
  },
  "homepage": "https://github.com/xrdavies/hamster-studio#readme",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "productName": "Hamster Studio"
}
