{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hamster Studio",
  "version": "../package.json",
  "identifier": "com.hamster.studio",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hamster Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["../build/icon.icns", "../build/icon.png"],
    "category": "Productivity",
    "macOS": { "minimumSystemVersion": "12.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/xrdavies/hamster-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
